# --- LiveKit (self-hosted SFU or LiveKit Cloud) --------------------------
# Local dev SFU (docker compose up): ws://localhost:7880 with devkey/secret
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
# Explicit dispatch name. Empty string => automatic dispatch (agent joins
# every new room). The web client's token route must request this name.
LIVEKIT_AGENT_NAME=chat-assistant

# --- LLM selection -------------------------------------------------------
# "provider:model" — supported: google, deepseek, openai.
# Gemini default (fastest first token, which voice lives or dies by).
# NOTE: Google retires model names for new users (gemini-2.5-flash already
# was). A 404 "no longer available" here means: change this line, not code.
LLM_MODEL=google:gemini-3.6-flash
# DeepSeek instead:   LLM_MODEL=deepseek:deepseek-chat
# OpenAI instead:     LLM_MODEL=openai:gpt-4.1-mini

# --- TTS selection -------------------------------------------------------
# "provider:model" — supported: deepgram, cartesia. Deepgram default means
# one DEEPGRAM_API_KEY covers both STT and TTS (the Aura-2 voice is part of
# the model name). A bare model name means Cartesia.
TTS_MODEL=deepgram:aura-2-andromeda-en
# Cartesia instead:   TTS_MODEL=cartesia:sonic-2  (+ CARTESIA_API_KEY)

# --- Model providers (bring your own keys; only the providers you chose
# --- above are required) --------------------------------------------------
DEEPGRAM_API_KEY=
GOOGLE_API_KEY=
# CARTESIA_API_KEY=
# DEEPSEEK_API_KEY=
# OPENAI_API_KEY=

# --- Research Agent (optional) -------------------------------------------
# Enables the research specialist (web search, open pages, official
# sources, cross-checked cited findings). Without it the graph keeps the
# plain fast-path shape and the worker boots normally.
# TAVILY_API_KEY=

# --- Vector store (Postgres + pgvector) — seam only; use cases next ------
# Local dev: docker compose up. In-cluster: see deploy/k8s/postgres.yaml
DATABASE_URL=postgresql://voice:voice@localhost:5432/voiceagent

# --- LangGraph seam ------------------------------------------------------
# true  => the LLM stage runs through the LangGraph in src/chat_assistant/graph/
# false => plain openai.LLM, bypassing the graph (the bisect switch)
USE_LANGGRAPH=true

# Optional: LangSmith tracing — wire before the first specialist lands.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
