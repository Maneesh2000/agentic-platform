# Server-side only — used by app/api/token/route.ts to mint access tokens.
# Local dev SFU (docker compose up at repo root): devkey/secret.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
# Must match the worker's LIVEKIT_AGENT_NAME (explicit dispatch).
LIVEKIT_AGENT_NAME=chat-assistant

# Auth (Auth.js). Generate a real secret with: openssl rand -base64 32
AUTH_SECRET=dev-only-change-me
# Users AND text-chat conversations live in the same Postgres as the vector
# store (docker compose up -d postgres). Web-owned tables use an app_ prefix.
DATABASE_URL=postgresql://voice:voice@localhost:5432/voiceagent

# Text surface: the stateless brain-over-HTTP service.
#   cd assistant && uv run assistant-chat
# The browser never calls it directly — /api/chat proxies, so this stays
# server-side. 8124 because 8080 is commonly occupied.
CHAT_SERVICE_URL=http://localhost:8124
